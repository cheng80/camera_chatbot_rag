LUMIX_APP_NAME="Panasonic LUMIX Manual Assistant"
LUMIX_DEBUG=false
LUMIX_STATIC_DIR="web"
LUMIX_DATA_DIR="data"
LUMIX_ALLOWED_ORIGINS='["*"]'
LUMIX_ENABLE_LOCAL_VECTOR=false
LUMIX_LLM_BASE_URL="http://127.0.0.1:11434/v1"
LUMIX_LLM_API_KEY="local"
LUMIX_LLM_SELECTION_MODE="auto"
LUMIX_LLM_MODEL="hf.co/mradermacher/supergemma4-e4b-abliterated-i1-GGUF:Q4_K_M"
LUMIX_LLM_FAST_MODEL="hf.co/mradermacher/supergemma4-e4b-abliterated-i1-GGUF:Q4_K_M"
LUMIX_LLM_THINKING_MODEL="hf.co/Qwen/Qwen3-8B-GGUF:Q4_K_M"
LUMIX_LLM_COMPARISON_MODELS='["hf.co/unsloth/gemma-4-E4B-it-qat-GGUF:UD-Q4_K_XL"]'
LUMIX_LLM_REQUEST_TIMEOUT_SECONDS=120
LUMIX_LLM_TEMPERATURE=0.2
LUMIX_LLM_MAX_TOKENS=512
LUMIX_LLM_THINK=false
LUMIX_LLM_REWRITE_ENABLED=true
LUMIX_LLM_REWRITE_MODEL="hf.co/unsloth/gemma-4-E4B-it-qat-GGUF:UD-Q4_K_XL"
LUMIX_LLM_REWRITE_FALLBACK_MODELS='["hf.co/mradermacher/supergemma4-e4b-abliterated-i1-GGUF:Q4_K_M"]'
LUMIX_LLM_REWRITE_MAX_TOKENS=128
LUMIX_LLM_REWRITE_THINK=false
LUMIX_EMBEDDING_BASE_URL="http://127.0.0.1:11434/v1"
LUMIX_EMBEDDING_API_KEY="local"
LUMIX_EMBEDDING_MODEL="bge-m3"
